# Pixelforge — Environment Variables
# Copy this file to .env.local and fill in your keys.

# Replicate API (get at https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=

# Lemon Squeezy (get at https://app.lemonsqueezy.com/settings/api)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=

# Vercel Blob (generate at https://vercel.com)
BLOB_READ_WRITE_TOKEN=
